---
/**
 * SiteSearch — 主页 / 文档页共用的站内搜索触发按钮（Plumest 窄版）。
 *
 * 仅提供触发按钮与 Ctrl/Cmd+K 快捷键，弹窗本体由 <PagefindModal> 组件承载
 * （样式内聚在 PagefindModal.astro，cp-pf-* 命名空间，不影响其他弹窗）。
 * 按钮样式（.cp-search-*）见 src/styles/site-nav.css。
 */
import { Icon } from 'astro-icon/components';
import type { Locale } from '../styles/celestial-tokens.ts';
import PagefindModal from './PagefindModal.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const zh = locale === 'zh';
const searchLabel = zh ? '搜索文档' : 'Search docs';
---

<site-search class="cp-search">
  <button
    type="button"
    class="cp-search-btn"
    data-cp-search-open
    aria-label={searchLabel}
    aria-keyshortcuts="Control+K"
  >
    <Icon name="lucide:search" size={16} aria-hidden="true" />
    <span class="cp-search-txt" aria-hidden="true">{searchLabel}</span>
    <kbd class="cp-search-kbd" aria-hidden="true">
      <kbd data-cp-search-mod>Ctrl</kbd><kbd>K</kbd>
    </kbd>
  </button>

  <PagefindModal locale={locale} />
</site-search>

<script>
  interface PagefindModalEl extends HTMLElement {
    open: () => void;
    close: () => void;
    isOpen: () => boolean;
  }

  class CpSiteSearch extends HTMLElement {
    constructor() {
      super();
      const openBtn = this.querySelector<HTMLButtonElement>('[data-cp-search-open]');
      const modal = this.querySelector<PagefindModalEl>('pagefind-modal');
      if (!openBtn || !modal) return;

      // 平台快捷键（Mac → ⌘K）
      const mod = this.querySelector<HTMLElement>('[data-cp-search-mod]');
      if (mod && /(Mac|iPhone|iPod|iPad)/i.test(navigator.platform)) {
        mod.textContent = '⌘';
        openBtn.setAttribute('aria-keyshortcuts', 'Meta+K');
      }

      openBtn.addEventListener('click', () => modal.open());
      // Ctrl / Cmd + K
      window.addEventListener('keydown', (e) => {
        if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
          e.preventDefault();
          if (modal.isOpen()) {
            modal.close();
          } else {
            modal.open();
          }
        }
      });
    }
  }
  customElements.define('site-search', CpSiteSearch);
</script>

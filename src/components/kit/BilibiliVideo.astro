---
// BilibiliVideo — 零请求视频 facade 的 Astro 包装（构建器 bilibiliFacade）。
// 页面只输出占位舞台 + 播放按钮 + 题注；播放器在浏览器点击或
// preload="auto" 视口临近时由 runtime 注入（runtime.ts initVideoFacades）。
// 用法：<BilibiliVideo bvid="BV1fK4y1s7Qf" title="演示" p={1} preload="auto" />
import { bilibiliFacade, getBilibiliEmbedData } from '../../lib/markdown/video';

interface Props {
  /** Bilibili 视频 BV 号 */
  bvid: string;
  /** 视频标题（题注与 iframe 无障碍描述） */
  title: string;
  /** 分 P 编号 */
  p?: number;
  /** 懒加载策略：none（默认，点击加载）| auto（视口临近预加载） */
  preload?: 'none' | 'auto';
}

const { bvid, title, p = 1, preload = 'none' } = Astro.props;

const embed = getBilibiliEmbedData({ bvid, title, p: String(p), preload });
if (!embed) {
  throw new Error(`[BilibiliVideo] invalid props: bvid="${bvid}" title="${title}" p=${p} preload="${preload}"`);
}
---

<Fragment set:html={bilibiliFacade(embed)} />

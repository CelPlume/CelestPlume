---
// Header 覆盖：与主页共用 SiteNav 顶部导航（同一套 Plumest 样式）+ 主页同款
// SiteSearch 搜索。菜单按钮（折叠导航抽屉入口）已内置于 SiteNav，按屏宽显隐。
import SiteNav from '../SiteNav.astro';
import SiteSearch from '../SiteSearch.astro';

const isZh = Astro.url.pathname.startsWith('/zh');
---

<SiteNav variant="docs" locale={isZh ? 'zh' : 'en'} pathname={Astro.url.pathname}>
  <SiteSearch slot="actions" locale={isZh ? 'zh' : 'en'} />
</SiteNav>

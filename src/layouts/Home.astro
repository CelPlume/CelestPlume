---
/**
 * CelestPlume — Home Layout（主页专用布局）
 * 独立完整 HTML（不依赖 Starlight Layout）。
 * 仅主页使用；文档页仍用 Starlight 内置 Layout 与其原主题。
 * 深浅色主题：主页使用 data-home-theme + localStorage('celplume-theme')，
 * 与文档页的 Starlight 主题互不影响。
 */
import '../styles/celestial.css';
import '../styles/site-nav.css';
import '../styles/fonts/fonts-home.css';
import SiteNav from '../components/SiteNav.astro';
import SiteSearch from '../components/SiteSearch.astro';
import { getUI, LOADER, type Locale } from '../styles/celestial-tokens.ts';

export interface Props {
  title: string;
  description?: string;
  locale: Locale;
}

const { title, description, locale } = Astro.props;
const t = getUI(locale);

const siteUrl = Astro.site ?? new URL('https://celplume.hxcn.space');
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#0a0f1c" data-home-theme-color />
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content={locale === 'zh'
        ? 'Celest Plume, 天空之翼, 文档站点, 开源, Astro, Starlight, Plumest, 时序同笺, 书签浏览器'
        : 'CelPlume, Celest Plume, documentation portal, open source, Astro, Starlight, Plumest, ChronoSync, BookmarkHarbor'}
    />
    <title>{title}</title>

    <link rel="canonical" href={new URL(currentPath, siteUrl).toString()} />
    <link rel="alternate" type="application/rss+xml" href="/rss.xml" title="RSS" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL('/images/og-cover.jpg', siteUrl).toString()} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content={new URL(currentPath, siteUrl).toString()} />
    <meta property="og:site_name" content={t.brand.name} />
    <meta property="og:locale" content={t.meta.ogLocale} />
    <meta property="og:locale:alternate" content={locale === 'zh' ? 'en_US' : 'zh_CN'} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL('/images/og-cover.jpg', siteUrl).toString()} />
    <meta name="twitter:site" content="@CelPlume" />

    <!-- Favicon -->
    <link rel="icon" type="image/jpeg" href="/images/CelPlume_favicon_256.jpg" />
    <link rel="apple-touch-icon" href="/images/CelPlume_256.jpg" />

    <!-- Fonts：经 frontmatter 引入 src/styles/fonts/fonts-home.css（按需打包） -->
    <link rel="preconnect" href="https://cdn.jsdelivr.net" />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <!-- 预加载正文字体（Manrope 400）：首绘前就绪，避免 font-display: swap 引起 CLS -->
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      crossorigin
      href="https://cdn.jsdelivr.net/npm/@fontsource/manrope@5.3.0/files/manrope-latin-400-normal.woff2"
    />

    <!-- 初始化主页主题（内联，避免 FOUC） -->
    <script is:inline>
      (function () {
        try {
          const key = 'celplume-theme';
          const media = window.matchMedia('(prefers-color-scheme: light)');
          let mode = 'system';
          const stored = window.localStorage.getItem(key);
          if (stored === 'dark' || stored === 'light' || stored === 'system') mode = stored;
          const resolved = mode === 'system' ? (media.matches ? 'light' : 'dark') : mode;
          document.documentElement.setAttribute('data-home-theme', resolved);
          document.documentElement.setAttribute('data-home-theme-mode', mode);
          const m = document.querySelector('meta[data-home-theme-color]');
          if (m) m.setAttribute('content', resolved === 'light' ? '#faf8f3' : '#0a0f1c');
        } catch {
          /* ignore */
        }
      })();
    </script>

    <!-- i18n 偏好（内联，避免闪语言）：celplume-lang 与当前页语言不一致时重定向，保留 query/hash -->
    <script is:inline>
      (function () {
        try {
          const key = 'celplume-lang';
          const pref = window.localStorage.getItem(key);
          if (pref !== 'zh' && pref !== 'en') return;
          const p = window.location.pathname;
          const isZhPath = p.startsWith('/zh');
          let target = null;
          if (pref === 'zh' && !isZhPath) target = '/zh/' + p.replace(/^\/+/, '');
          if (pref === 'en' && isZhPath) target = p.slice(3) || '/';
          if (target && target !== p) {
            window.location.replace(target + window.location.search + window.location.hash);
          }
        } catch {
          /* storage unavailable — 保持当前语言 */
        }
      })();
    </script>

  </head>
  <body>
    <a class="skip-link" href="#main">{locale === 'zh' ? '跳到主要内容' : 'Skip to content'}</a>

    <!-- 加载动画（Uiverse.io by dexter-st: bright-lizard-8，纯 CSS；仅英文 Loading） -->
    <div class="cp-loader" id="cp-loader" role="status" aria-label="Loading" aria-hidden="true">
      <div class="loader-wrapper">
        {LOADER.letters.map((ch) => (
          <span class="loader-letter">{ch}</span>
        ))}
        <div class="loader"></div>
      </div>
    </div>

    <!-- 全局背景（柔和径向渐变） -->
    <div class="cp-bg-glow" aria-hidden="true"></div>

    <!-- 导航 -->
    <!-- 共享导航（SiteNav：品牌 + 四项导航 + 项目 dropdown + 搜索 + 主题/语言切换） -->
    <SiteNav locale={locale} pathname={currentPath}>
      <SiteSearch slot="actions" locale={locale} />
    </SiteNav>

    <!-- 主内容 -->
    <main id="main" role="main">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="cp-footer" role="contentinfo">
      <div class="cp-footer-inner">
        <div class="cp-footer-brand">
          <img src="/images/CelPlume_256.jpg" alt="" class="cp-footer-logo" width="64" height="64" />
          <div>
            <p class="cp-footer-title cp-font-display cp-gold-gradient-text">{t.brand.name}</p>
            <p class="cp-footer-sub">{t.footer.brandSubtitle}</p>
          </div>
        </div>

        <nav class="cp-footer-links" aria-label={locale === 'zh' ? '页脚导航' : 'Footer'}>
          {t.footer.columns.map((col) => (
            <div>
              <p class="cp-footer-heading">{col.heading}</p>
              <ul>
                {col.links.map((l) => (
                  <li>
                    <a
                      href={l.href}
                      target={l.external ? '_blank' : undefined}
                      rel={l.external ? 'noopener noreferrer' : undefined}
                    >
                      {l.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </nav>
      </div>

      <div class="cp-footer-bottom">
        <p>
          © {new Date().getFullYear()}{' '}
          <a
            href={t.footer.officialUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="cp-footer-copy-link"
          >
            {t.footer.copyrightBrand}
          </a>
          {t.footer.copyrightSuffix}
        </p>
        <p class="cp-footer-legal">{t.footer.builtWith}</p>
      </div>
    </footer>

    <!-- 主页运行时: 加载动画隐藏 + 主题切换 + 跟随系统 -->
    <script>
      import { THEME_STORAGE_KEY, LANG_STORAGE_KEY, LOADER } from '../styles/celestial-tokens.ts';
      import { initDropdowns } from '../lib/ui/runtime';

      // 1. 加载动画（uiverse 纯 CSS）—— 字体就绪 + 最少展示 800ms，1s 兜底；
      //     prefers-reduced-motion 直接隐藏（不展示、不阻塞首屏）
      const overlay = document.getElementById('cp-loader') as HTMLDivElement | null;
      if (overlay) {
        if (window.matchMedia?.('(prefers-reduced-motion: reduce)').matches) {
          overlay.remove();
        } else {
          const tStart = performance.now();
          const hideLoader = () => {
            const wait = Math.max(0, LOADER.minShowMs - (performance.now() - tStart));
            setTimeout(() => {
              overlay.dataset.hidden = 'true';
              setTimeout(() => overlay.remove(), LOADER.fadeOutMs + 80);
            }, wait);
          };

          const fontsReady = (document as Document & { fonts?: FontFaceSet }).fonts?.ready;
          if (fontsReady) {
            fontsReady.then(hideLoader).catch(hideLoader);
          } else {
            window.addEventListener('load', hideLoader, { once: true });
          }
          window.setTimeout(hideLoader, LOADER.fallbackMs);
        }
      }

      // 2. 主题切换（三态：system → light → dark，默认跟随系统）
      const toggleBtn = document.getElementById('cp-theme-toggle') as HTMLButtonElement | null;
      const root = document.documentElement;
      const themeMeta = document.querySelector('meta[data-home-theme-color]') as HTMLMetaElement | null;
      const media = window.matchMedia('(prefers-color-scheme: light)');
      const CYCLE = ['system', 'light', 'dark'] as const;
      const currentMode = () => {
        const m = root.getAttribute('data-home-theme-mode');
        return m === 'dark' || m === 'light' || m === 'system' ? m : 'system';
      };

      const applyTheme = (mode: 'dark' | 'light' | 'system') => {
        const resolved = mode === 'system' ? (media.matches ? 'light' : 'dark') : mode;
        root.setAttribute('data-home-theme', resolved);
        root.setAttribute('data-home-theme-mode', mode);
        try {
          window.localStorage.setItem(THEME_STORAGE_KEY, mode);
        } catch {
          /* ignore */
        }
        if (themeMeta) themeMeta.setAttribute('content', resolved === 'light' ? '#faf8f3' : '#0a0f1c');
      };

      toggleBtn?.addEventListener('click', () => {
        const next = CYCLE[(CYCLE.indexOf(currentMode()) + 1) % CYCLE.length];
        applyTheme(next);
      });

      // 3. 跟随系统（仅当模式为 system 时响应系统偏好变化）
      media.addEventListener?.('change', () => {
        if (currentMode() === 'system') applyTheme('system');
      });

      // 4. i18n 偏好：点击语言切换时写入 localStorage（供下次访问重定向到目标语言）
      document.querySelectorAll<HTMLAnchorElement>('[data-cp-lang-switch]').forEach((langLink) => {
        langLink.addEventListener('click', () => {
          try {
            const target = langLink.getAttribute('href')?.startsWith('/zh') ? 'zh' : 'en';
            window.localStorage.setItem(LANG_STORAGE_KEY, target);
          } catch {
            /* storage unavailable */
          }
        });
      });

      // 5. 项目 dropdown（复用 Kit Dropdown：hover + 键盘 + 外点关闭）
      initDropdowns();
    </script>
  </body>
</html>
